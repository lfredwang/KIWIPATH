# ==============================================================================
# KiwiPath — Environment Configuration Template (.env.example)
# Copy to `.env.local` if customising local behaviour. NEVER commit real secrets.
# ==============================================================================

# Data mode: V1 is strictly "offline" (100% local IndexedDB + curated datasets).
# Future V2 may switch to "online" only after backend & auth are approved.
VITE_DATA_MODE=offline

# Application display metadata
VITE_APP_NAME=KiwiPath
VITE_POLICY_BASELINE_DATE=2026-11

# Reserved for future V2 online extensions (DO NOT populate in V1 offline build)
# VITE_API_BASE_URL=
# VITE_ENABLE_LIVE_FEEDS=false
