{
  "name": "kiwipath-web",
  "private": true,
  "version": "1.0.0",
  "description": "KiwiPath (新西兰人成长学院) — Offline-first Progressive Bilingual New Zealand Immigrant Learning & Direct Hiring Web App",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && node scripts/build-singlefile.mjs",
    "export:db": "node --import ./tests/ts-loader.mjs scripts/export-content-db.mjs",
    "preview": "vite preview",
    "test": "node --import ./tests/ts-loader.mjs --test tests/*.test.ts"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^1.0.0"
  }
}
